# Neon project connection string (Neon dashboard → Connection Details,
# or `npx neonctl connection-string` after `npx neonctl init`).
# Use the pooled connection string.
DATABASE_URL=

# Groq API key (console.groq.com) — used by lib/extract-vocab.ts to
# draft English glosses for new vocabulary. Required at runtime for
# vocab extraction; throws a clear error if missing rather than
# silently skipping the gloss step.
GROQ_API_KEY=
